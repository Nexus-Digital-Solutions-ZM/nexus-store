{
  "name": "nexus-store",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus Store - mini online store (frontend + backend).",
  "scripts": {
    "dev": "npm --workspace frontend run dev & npm --workspace backend run dev",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:all": "npm install:frontend && npm install:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start:frontend": "cd frontend && npm run preview",
    "start:backend": "cd backend && npm run start"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}